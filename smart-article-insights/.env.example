# Environment variables for Smart Article Insights Generator
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# Optional: Hugging Face token (only needed for gated/private models)
# TinyLlama and all-MiniLM-L6-v2 are public — no token required.
# HF_TOKEN=your_huggingface_token_here

# Optional: Force CPU even when CUDA is available (set to "1" to enable)
# FORCE_CPU=0

# Optional: Custom model cache directory (defaults to ~/.cache/huggingface)
# TRANSFORMERS_CACHE=/path/to/your/model/cache
